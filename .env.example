# Copy to .env and adjust. docker-compose.yml has sensible defaults for every value.
POSTGRES_DB=diamond_salon
POSTGRES_USER=diamond
POSTGRES_PASSWORD=diamond
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

BACKEND_PORT=8000
FRONTEND_PORT=5173

PGADMIN_EMAIL=admin@diamond.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
